# Build products for this autotools tree (it builds in-tree; see BUILDING.md).
# Paths are anchored deliberately: a few files that LOOK generated are tracked
# (build-aux/config.rpath, src/include/mbedtls/config.h, src/synop-src/Makefile,
# po/Makefile.in.in), so bare `Makefile` / `config.h` patterns must not be used.

# --- generated by autoreconf ---
/configure
/aclocal.m4
/autom4te.cache/
/build-aux/compile
/build-aux/config.guess
/build-aux/config.sub
/build-aux/depcomp
/build-aux/install-sh
/build-aux/missing
/build-aux/test-driver

# --- generated by configure ---
/config.log
/config.status
/Makefile
/Makefile.in
/doc/Makefile
/doc/Makefile.in
/src/Makefile
/src/Makefile.in
/po/Makefile
/po/Makefile.in
/src/config.h
/src/config.h.in
/src/stamp-h1

# --- compiled output ---
*.o
*.lo
*.la
.deps/
.dirstamp
.libs/

# --- built binaries ---
/src/fldigi
/src/flarq

# --- gettext / po generated (po/Makefile.in.in and po/Makevars are tracked) ---
*.gmo
/po/Makevars.template
/po/POTFILES
/po/stamp-po

# --- man pages generated from the tracked .1.txt sources ---
/doc/fldigi.1
/doc/flarq.1

# --- editor / OS noise ---
*~
.DS_Store
